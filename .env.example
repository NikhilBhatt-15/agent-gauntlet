# Copy to .env (or set as Azure App Settings). Every value is optional.
# With no LLM key at all, the site still works: runs use the simulated buyer.

# --- Free LLM providers (any subset; tried in LLM_PROVIDER_ORDER, falling back on rate limits) ---
GROQ_API_KEY=            # https://console.groq.com/keys
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
LLM_PROVIDER_ORDER=groq,gemini,openrouter,custom

# Model overrides (defaults shown). The buyer needs a smart model; voices can be tiny.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VOICE_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_VOICE_MODEL=gemini-flash-lite-latest
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Any other OpenAI-compatible endpoint (e.g. a local Ollama at http://localhost:11434/v1)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_VOICE_MODEL=

# Vendor messages: "llm" (one cheap batched call per round) or "template" (zero LLM calls)
VENDOR_VOICE=llm

# --- Quota protection ---
MAX_LLM_RUNS_PER_DAY=30          # server-funded LLM runs per UTC day
LLM_RUNS_PER_HOUR_PER_IP=5
SIM_RUNS_PER_HOUR_PER_IP=40
BYOK_RUNS_PER_HOUR_PER_IP=20
MAX_CONCURRENT_LLM_RUNS=3

# --- Optional Cloudflare Turnstile (free bot protection) ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Storage & escrow ---
DATA_DIR=./data                  # use /home/data on Azure App Service (persistent)
# ESCROW_PRIVATE_KEY=            # Ed25519 PKCS8 PEM (or base64 of it); generated + saved in DATA_DIR if unset
# PORT=8787
