# Copy to .env (or set as Azure App Settings). Every value is optional.
# With no LLM key, shopkeepers run in offline practice mode (scripted, unranked).

# --- Free LLM providers (any subset; tried in LLM_PROVIDER_ORDER, falling back on rate limits) ---
GROQ_API_KEY=            # https://console.groq.com/keys
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
LLM_PROVIDER_ORDER=groq,gemini,openrouter,custom

# Model overrides (defaults shown). Comma-separated = fallbacks within the provider.
# "MODEL" plays the shopkeeper and Munim ji (needs to be smart); "VOICE_MODEL" writes the end-of-game recap.
# GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_VOICE_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.5-flash,gemini-flash-lite-latest
# GEMINI_VOICE_MODEL=gemini-flash-lite-latest
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_VOICE_MODEL=openrouter/free

# Any other OpenAI-compatible endpoint (e.g. Ollama at http://localhost:11434/v1, or `npm run mock-llm`)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# --- Quota protection ---
MAX_LLM_TURNS_PER_DAY=1500       # shopkeeper replies per UTC day across all players
GAMES_PER_HOUR_PER_IP=20
MESSAGES_PER_MINUTE_PER_IP=12

# --- Storage & signing ---
DATA_DIR=./data                  # use /home/data on Azure App Service (persistent)
# ESCROW_PRIVATE_KEY=            # Ed25519 PKCS8 PEM for signing bills; generated + saved in DATA_DIR if unset
# PORT=8787
